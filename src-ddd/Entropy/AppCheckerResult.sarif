                "region": {
                  "charLength": 2646,
                  "charOffset": 2217,
                  "snippet": {
                    "text": "{\n                            Title: If(IsBlank(varChildTitle) Or varChildTitle = \"\", \"New archive\", varChildTitle),\n                            Description: varChildDescription,\n                            // Single-select Choice columns: patch as a record {Value:\"...\"}, not Table({...}).\n                            MediaType: {Value: varChildMediaType},\n                            CaptureDate: varChildCaptureDate,\n                            ProductionPlace: varChildProductionPlace,\n                            ProductType: If(\n                                IsBlank(varChildProductType) Or varChildProductType = \"\",\n                                Blank(),\n                                {Value: varChildProductType}\n                            ),\n                            SeriesTitle: varChildSeriesTitle,\n                            EpisodeTitle: varChildEpisodeTitle,\n                            EpisodeSummary: varChildEpisodeSummary,\n                            SeasonNumber: varChildSeasonNumber,\n                            EpisodeNumber: varChildEpisodeNumber,\n                            ProductionEndDate: varChildProductionEndDate,\n                            PublicationStartDate: varChildPublicationStartDate,\n                            PublicationEndDate: varChildPublicationEndDate,\n                            ReferenceLinks: varChildLinks,\n                            Tags: varChildTags,\n                            FTPPath: varChildFTPPath,\n                            LanguageVersions: {Value: varChildLanguageVersions},\n                            // AIVoiceover column is TEXT; var is Boolean by convention, converted here only.\n                            AIVoiceover: If(varChildAIVoiceover, \"Yes\", \"No\"),\n                            ContractCase: {Value: varChildContractCase},\n                            ContractCase1Sub: If(\n                                IsBlank(varChildContractCase1Sub) Or varChildContractCase1Sub = \"\",\n                                Blank(),\n                                {Value: varChildContractCase1Sub}\n                            ),\n                            ContractReference: varChildContractRef,\n                            MusicUsed: varChildMusicUsed,\n                            MusicLicenseProvided: varChildMusicLicenceProvided,\n                            PreexistingRightsProvided: varChildPreexistingProvided,\n                            ModelReleaseProvided: varChildModelReleaseProvided,\n                            DepositStatus: {Value: \"Pending Approval\"},\n                            ParentRequest: varCurrentRequest.RequestNumber\n                        }"
                  }
                }
              },
              "properties": {
                "member": "OnSelect",
                "module": "ChildValidScreen",
                "type": "ChildValidScreen.CV_BtnSaveArchive"
              }
