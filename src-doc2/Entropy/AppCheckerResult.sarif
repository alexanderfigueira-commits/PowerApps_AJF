                "region": {
                  "charLength": 2754,
                  "charOffset": 2227,
                  "snippet": {
                    "text": "{\n                            Title: If(IsBlank(varChildTitle1) Or varChildTitle1 = \"\", \"New archive\", varChildTitle1),\n                            Description: varChildDescription1,\n                            // Multi-select Choice columns (per connector schema): patch as Table({Value:\"...\"}).\n                            MediaType: Table({Value: varChildMediaType}),\n                            Credits: varChildCredits1,\n                            CaptureDate: varChildCaptureDate,\n                            ProductionPlace: varChildProductionPlace1,\n                            ProductType: If(\n                                IsBlank(varChildProductType) Or varChildProductType = \"\",\n                                Blank(),\n                                Table({Value: varChildProductType})\n                            ),\n                            SeriesTitle: varChildSeriesTitle1,\n                            EpisodeTitle: varChildEpisodeTitle,\n                            EpisodeSummary: varChildEpisodeSummary1,\n                            SeasonNumber: varChildSeasonNumber,\n                            EpisodeNumber: varChildEpisodeNumber,\n                            ProductionEndDate: varChildProductionEndDate,\n                            PublicationStartDate: varChildPublicationStartDate,\n                            PublicationEndDate: varChildPublicationEndDate,\n                            ReferenceLinks: varChildLinks1,\n                            Tags: varChildTags,\n                            FTPPath: varChildFTPPath,\n                            LanguageVersions: Table({Value: varChildLanguageVersions}),\n                            // AIVoiceover column is TEXT; var is Boolean by convention, converted here only.\n                            AIVoiceover: If(varChildAIVoiceover, \"Yes\", \"No\"),\n                            ContractCase: Table({Value: varChildContractCase}),\n                            ContractCase1Sub: If(\n                                IsBlank(varChildContractCase1Sub) Or varChildContractCase1Sub = \"\",\n                                Blank(),\n                                Table({Value: varChildContractCase1Sub})\n                            ),\n                            ContractReference: varChildContractRef1,\n                            MusicUsed: varChildMusicUsed,\n                            MusicLicenseProvided: varChildMusicLicenceProvided,\n                            PreexistingRightsProvided: varChildPreexistingProvided,\n                            ModelReleaseProvided: varChildModelReleaseProvided,\n                            DepositStatus: Table({Value: \"Pending Approval\"}),\n                            ParentRequest: varCurrentRequest.RequestNumber\n                        }"
                  }
                }
              },
              "properties": {
                "member": "OnSelect",
                "module": "ChildValidScreen",
                "type": "ChildValidScreen.CV_BtnSaveArchive"
              }
            }
