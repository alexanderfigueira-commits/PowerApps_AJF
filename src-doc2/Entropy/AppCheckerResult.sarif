                  "snippet": {
                    "text": "{\n            Status: {Value: \"Approved\"},\n            // Assignee(s) = the approver, plus any co-assignees selected in RV_Assignee.\n            DG_Agency_Contact: ForAll(\n                Ungroup(\n                    Table(\n                        {u: Table({DisplayName: User().FullName, Mail: User().Email})},\n                        {u: ShowColumns(RV_Assignee.SelectedItems, \"DisplayName\", \"Mail\")}\n                    ),\n                    \"u\"\n                ) As pers,\n                {\n                    '@odata.type': \"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedUser\",\n                    Claims: \"i:0#.f|membership|\" & Lower(pers.Mail),\n                    DisplayName: pers.DisplayName,\n                    Email: pers.Mail,\n                    Department: \"\",\n                    JobTitle: \"\",\n                    Picture: \"\"\n                }\n            ),\n            ReviewedByContact: Table({\n                '@odata.type': \"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedUser\",\n                Claims: \"i:0#.f|membership|\" & Lower(User().Email),\n                DisplayName: User().FullName,\n                Email: User().Email,\n                Department: \"\",\n                JobTitle: \"\",\n                Picture: \"\"\n            }),\n            ReviewedDate: Now()\n        }"
                  }
