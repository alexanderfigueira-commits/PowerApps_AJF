        "Property": "OnStart",
        "Category": "Behavior",
        "InvariantScript": "// Initialize the Office365Connected variable\r\nSet(Office365Connected, true);\r\n\r\n//Set the pop message\r\nSet(varShowPopup, false);\r\n\r\n// Check Office 365 profile access and update the Office365Connected variable\r\nIfError(\r\n    Set(MyProfile, Office365Users.MyProfile()),\r\n    Set(Office365Connected, false)\r\n);\r\n\r\nSet(VideoCoverageSelected, false);\r\nSet(OnlyConferenceEventSelected, false);\r\nSet(ConferenceEventSelected, false);\r\nSet(ResetCheckboxes, false);\r\n\r\nSet(varCollegeMember, Blank());\r\nSet(varEventTitle, Blank());\r\nSet(varStartDateTime, Blank());\r\nSet(varStartDate, Blank());\r\nSet(varStartHour, Blank());\r\nSet(varStartMinute, Blank());\r\nSet(varEndDateTime, Blank());\r\nSet(varEndDate, Blank());\r\nSet(varEndHour, Blank());\r\nSet(varEndMinute, Blank());\r\nSet(varLocation, Blank());\r\nSet(varAddress, Blank());\r\nSet(varEventTypes, Blank());\r\nSet(otherEventValue, Blank());\r\nSet(VIPEventValue, Blank());\r\nSet(varCoverageTypes, Blank());\r\nSet(varEventCoverageType, Blank());\r\nSet(varWebstreamed, Blank());\r\nSet(varWebstreamedOrganizer, Blank());\r\nSet(varPublicationType, Blank());\r\nSet(varContacts, Blank());\r\n\r\n\r\nSet(varComments, Blank());\r\n\r\n\r\n\r\nNewForm(CoverageFormRequest);",
